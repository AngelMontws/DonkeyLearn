@model DonkeyLearn.Models.MateriaModel
@{
    ViewData["Title"] = "Menu";
	var materias = ViewData["Materias"] as List<MateriaModel>;
}

<link href="~/css/menu.css" rel="stylesheet" />

@if (!string.IsNullOrEmpty(TempData["Mensaje"] as string))
{
	<div class="alert alert-success">
		@TempData["Mensaje"]
	</div>
}
@if (!string.IsNullOrEmpty(TempData["Error"] as string))
{
	<div class="alert alert-danger">
		@TempData["Error"]
	</div>
}
<p style="margin: 25px;">
	<h1 style="font-family: Impact, Haettenschweiler, 'Arial Narrow Bold', sans-serif"><font size="15">UNIDADES DE APRENDIZAJE</font></h1>
</p>
<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<title>Menú </title>
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/meyer-reset/2.0/reset.min.css">
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link href="~/css/menualumno2.css" rel="stylesheet" />
    <link href="~/css/menu.css" rel="stylesheet" />
</head>
<body>
	<div class="container">
		<nav class="navbar">
		<ul class="navbar__menu">
			<li class="navbar__item">
				<a asp-action="Cuenta" asp-controller="Cuenta" class="navbar__link"><i class="fas fa-gear"></i><span>Ajustes de cuenta</span></a>
			</li>
			<li class="navbar__item">
					<a href="Reportes" class="navbar__link"><i class="fas fa-chart-simple"></i><span>Rendimiento</span></a>
			</li>
			<li class="navbar__item">
				<a href="@Url.Action("Logout", "Admin")" class="navbar__link"><i class="fas fa-circle-xmark"></i><span>Cerrar sesión</span></a>
			</li>
		</ul>
	</nav>
	</div>
</body>
<div class="container" style="margin-left: 120px;" style= "margin:25px">
	<div class="row">
		<form asp-action="AñadirClase" method="post">
			<h2>Inscribete a una clase</h2>
			<div class="input-group">
			<input type="text" placeholder="Código de clase" asp-for="llave">
			<span class="input-group-btn">
				<button type="submit">Ingresar</button>
				</span>
		</form>
		<p aling="left">
		<p>Solicita a tu profesor tu código para clases</p>
	</div>
		@foreach (var materia in materias)
		{
			
			<form class="col-lg-4" asp-action="EscogerCues" method="get">
			
				<div class="our-team-main">
					<div class="team-front">
						<h3>@materia.Nombre</h3>
						<input type="hidden" value="@materia.ID" asp-for="ID"/>
					</div>
					
					<div class="team-back">
						<span>
							<center>
							<button type="submit">Iniciar</button>
							</center>
						</span>
					</div>
				</div>
				
			</form>
		}
</html>