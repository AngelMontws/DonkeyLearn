@{
    ViewData["Title"] = "VerCuestionario";
    var cuestionario = ViewData["Cuestionario"] as CuestionarioModel; // Recupera el modelo de ViewData
}

<h1>@cuestionario.NombreCuestionario</h1>

<form asp-action="SubirPuntaje" method="post">
    @for (int i = 0; i < cuestionario.Preguntas.Count; i++)
    {
        <div>
            <h2>@cuestionario.Preguntas[i].Pregunta</h2>
            @for (int j = 0; j < cuestionario.Preguntas[i].Respuestas.Count; j++)
            {
                <div>
                    <input name="cuestionario.Preguntas[@i].RespuestaSeleccionada" type="radio" value="@cuestionario.Preguntas[i].Respuestas[j].ID" onclick="actualizarPuntaje('@cuestionario.Preguntas[i].Respuestas[j].EsCorrecta'.toLowerCase())" />
                    <label>@cuestionario.Preguntas[i].Respuestas[j].Respuesta</label>
                </div>
            }
        </div>
    }
    <input type="hidden" name="cuestionario.ID" value="@ViewData["CuestionarioID"]" />
    <input type="hidden" id="puntaje" name="cuestionario.Puntaje" value="0" />
    <button type="submit">Enviar</button>
</form>

<script>
    function actualizarPuntaje(esCorrecta) {
        if (esCorrecta === 'true') {
            var puntaje = document.getElementById('puntaje');
            puntaje.value = parseInt(puntaje.value) + 1;
        }
    }
</script>
