@{
    ViewData["Title"] = "VerCuestionario";
    var cuestionario = ViewData["Cuestionario"] as CuestionarioModel; // Recupera el modelo de ViewData
}
<h1>@cuestionario.NombreCuestionario</h1>
<form asp-action="SubirPuntaje" method="post" onsubmit="calcularPuntaje()">

    @for (int i = 0; i < cuestionario.Preguntas.Count; i++)
    {
        <div>
            <h2>@cuestionario.Preguntas[i].Pregunta</h2>
            @for (int j = 0; j < cuestionario.Preguntas[i].Respuestas.Count; j++)
            {
                <div>
                    @{
                        var respuesta = cuestionario.Preguntas[i].Respuestas[j];
                        var esCorrecta = respuesta.EsCorrecta ? "true" : "false";
                    }
                    <input name="cuestionario.Preguntas[@i].RespuestaSeleccionada" type="radio" value="@respuesta.ID" data-es-correcta="@esCorrecta" />
                    <label>@respuesta.Respuesta</label>
                </div>
            }

        </div>
    }
    <input type="hidden" name="cuestionario.ID" value="@ViewData["CuestionarioID"]" />
    <input type="hidden" name="cuestionario.Puntaje" value="0" id="puntaje" />
    <button type="submit">Enviar</button>
</form>

<script>
    function calcularPuntaje() {
        var respuestasSeleccionadas = document.querySelectorAll('input[name^="cuestionario.Preguntas"]:checked');
        var puntaje = 0;

        respuestasSeleccionadas.forEach(function (respuesta) {
            var esCorrecta = respuesta.getAttribute('data-es-correcta');
            if (esCorrecta === 'true') {
                puntaje++;
            }
        });

        document.getElementById('puntaje').value = puntaje;
    }
</script>
