@model DonkeyLearn.Models.CuestionarioModel
@{
    ViewData["Title"] = "EscogerCues";
	var cuestionarios = ViewData["Cuestionarios"] as List<CuestionarioModel>;
}

@if (!string.IsNullOrEmpty(TempData["Mensaje"] as string))
{
	<div class="alert alert-success">
		@TempData["Mensaje"]
	</div>
}
@if (!string.IsNullOrEmpty(TempData["Error"] as string))
{
	<div class="alert alert-danger">
		@TempData["Error"]
	</div>
}
<center>
	<p style="margin: 25px;">
		<h1 style="font-family: Impact, Haettenschweiler, 'Arial Narrow Bold', sans-serif"><font size="15">ELIGE TU CUESTIONARIO</font></h1>
	</p>
</center>
<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<title>Cuestionarios </title>
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/meyer-reset/2.0/reset.min.css">
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link href="~/css/menualumno2.css" rel="stylesheet" />
    <link href="~/css/menu.css" rel="stylesheet" />
</head>
<body>
	<div class="container">
		<nav class="navbar">
			<ul class="navbar__menu">
				<li class="navbar__item">
					<a asp-action="Cuenta" asp-controller="Cuenta" class="navbar__link"><i class="fas fa-gear"></i><span>Ajustes de cuenta</span></a>
				</li>
				<li class="navbar__item">
					<a href="Reportes" class="navbar__link"><i class="fas fa-chart-simple"></i><span>Rendimiento</span></a>
				</li>
				<li class="navbar__item">
					<a href="@Url.Action("Logout", "Alumno")" class="navbar__link"><i class="fas fa-circle-xmark"></i><span>Cerrar sesión</span></a>
				</li>
			</ul>
		</nav>
	
</div>
</body>

	<a asp-action="Menu" class="btn btn-success">Volver</a>
	<div class="row">
		@foreach (var cuestionario in cuestionarios)
		{
			<form class="col-lg-4" asp-action="VerCuestionario" method="get">
			<p aling="right">
				<div class="our-team-main">
					<div class="team-front">
						<h3>@cuestionario.NombreCuestionario</h3>
						<input type="hidden" value="@cuestionario.ID" asp-for="ID" />
					</div>
					<div class="team-back">
						<span>
							<button type="submit">Iniciar</button>
						</span>
					</div>
				</div>
				</p>
			</form>
		}
	</div>
</html>
