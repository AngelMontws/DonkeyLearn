@model DonkeyLearn.Models.DatosModel

@{
    ViewData["Title"] = "Inicio";
}

<link rel="stylesheet" href="~/css/Inicio.css" />

@if (!string.IsNullOrEmpty(TempData["Mensaje"] as string))
{
    <div class="alert alert-success">
        @TempData["Mensaje"]
    </div>
}
@if (!string.IsNullOrEmpty(TempData["Error"] as string))
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<div class="wrapper">
    <div class="card-switch">
        <label class="switch">
            <input type="checkbox" class="toggle">
            <span class="slider"></span>
            <span class="card-side"></span>
            <div class="flip-card__inner">
                <div class="flip-card__front">
                    <div class="title">Inicio de Sesión</div>
                    <form class="flip-card__form" asp-action="Login" method="post">
                        <input required type="text" asp-for="IdUsuario" class="flip-card__input" name="IdUsuario" placeholder="Boleta o No. de Empleado" oninput="this.value = this.value.replace(/[^0-9]/g, '')" minlength="8" maxlength="10">
                        <input required asp-for="Contrasena" type="password" class="flip-card__input" name="Contrasena" placeholder="Contraseña" minlength=" 8">
                        <button type="submit" class="flip-card__btn" name="submitButton" value="Ingresar">Ingresar</button>
                        <p>¿Olvidaste tu contraseña? <a asp-action="RecuperarContra" style="color: purple">Da click aquí</a></p>
                    </form>
                </div>
                <div class="flip-card__back">
                    <div class="title">Crear Cuenta</div>
                    <form class="flip-card__form" asp-action="Alumno" method="post">
                        <input required type="text" asp-for="IdUsuario" class="flip-card__input" name="IdUsuario" placeholder="Boleta o ID" oninput="this.value = this.value.replace(/[^0-9]/g, '')" minlength="8" maxlength="10">
                        <input required maxlength="30" type="text" asp-for="Nombre" class="flip-card__input" name="Nombre" placeholder="Nombre" oninput="this.value = this.value.replace(/[^a-zA-Z\sáéíóú]/g, '')">
                        <input required maxlength="35" type="text" asp-for="ApPaterno" class="flip-card__input" name="ApPaterno" placeholder="Apellido Paterno" oninput="this.value = this.value.replace(/[^a-zA-Z\áéíóú]/g, '')">
                        <input required maxlength="35" type="text" asp-for="ApMaterno" class="flip-card__input" name="ApMaterno" placeholder="Apellido Materno" oninput="this.value = this.value.replace(/[^a-zA-Z\áéíóú]/g, '')">
                        <input required maxlength="320" asp-for="CorreoElectronico" type="email" class="flip-card__input " name="CorreoElectronico" placeholder="Correo Electrónico">
                        <input required asp-for="Contrasena" type="password" class="flip-card__input " name="Contrasena" placeholder="Contraseña" minlength=" 8">
                        <button type="submit" name="submitButton" value="Registrarse" class="flip-card__btn">Registrarse</button>
                        <p><a asp-action="Inicio2" style="color: purple">Soy profesor o administrador</a> </p>
                        <p><a asp-action="Acercade" style="color: purple"> Acerca de Nosotros</a></p>
                    </form>
                </div>
                <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
                <script>
                    $(document).ready(function () {
                        $('form input').on('keydown', function (e) {
                            if (e.which == 13) { // Enter key
                                e.preventDefault();
                                var nextInput = $('input[type=text],input[type=password],input[type=email]', $(this).closest('form')).eq($('input[type=text],input[type=password],input[type=email]', $(this).closest('form')).index(this) + 1);
                                if (nextInput.length) {
                                    nextInput.focus();
                                } else {
                                    $(this).closest('form').submit();
                                }
                            }
                        });
                    });
                </script>
            </div>
        </label>
    </div>
</div>