@model DonkeyLearn.Models.DatosModel
@{
    ViewData["Title"] = "Inicio2";
}
<link href="//maxcdn.bootstrapcdn.com/bootstrap/4.1.1/css/bootstrap.min.css" rel="stylesheet" id="bootstrap-css">
<script src="//maxcdn.bootstrapcdn.com/bootstrap/4.1.1/js/bootstrap.min.js"></script>
<script src="//cdnjs.cloudflare.com/ajax/libs/jquery/3.2.1/jquery.min.js"></script>
<!------ Include the above in your HEAD tag ---------->

<div class="container register">
    <div class="row">
        <div class="col-md-3 register-left">
            <h3>Bienvenido</h3>
            <p>Llena los datos que se te solicitan</p>
            <a asp-action="Inicio" type="submit" name="" value="volver" class="btn btn-primary">Volver</a><br />
        </div>
        <div class="col-md-9 register-right">
            <ul class="nav nav-tabs nav-justified" id="myTab" role="tablist">
                <li class="nav-item">
                    <a class="nav-link active" id="home-tab" data-toggle="tab" href="#home" role="tab" aria-controls="home" aria-selected="true">Profesor</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" id="profile-tab" data-toggle="tab" href="#profile" role="tab" aria-controls="profile" aria-selected="false">Administrador</a>
                </li>
            </ul>
            <div class="tab-content" id="myTabContent">

                <form class="tab-pane fade show active" id="home" role="tabpanel" aria-labelledby="home-tab" asp-action ="Profe" method="post">
                    <h3 class="register-heading">Registro para profesor</h3>
                    <div class="row register-form">
                        <div class="col-md-6">
                            <div class="form-group">
                                <input asp-for="Nombre" type="text" class="form-control" placeholder="Nombre *" value="" oninput="this.value = this.value.replace(/[^a-zA-Z]/g, '')" />
                            </div>
                            <div class="form-group">
                                <input asp-for="ApPaterno" type="text" class="form-control" placeholder="Apellido Paterno *" value="" oninput="this.value = this.value.replace(/[^a-zA-Z]/g, '')" />
                            </div>
                            <div class="form-group">
                                <input asp-for="ApMaterno" type="text" class="form-control" placeholder="Apellido Materno *" value="" oninput="this.value = this.value.replace(/[^a-zA-Z]/g, '')" />
                            </div>
                            <div class="form-group">
                                <input asp-for="Contrasena" type="password" class="form-control" placeholder="Contraseña *" value="" />
                            </div>
                            <div class="form-group">
                                <input asp-for="IdUsuario" type="text" class="form-control" placeholder="No. de empleado *" value="" oninput="this.value = this.value.replace(/[^0-9]/g, '')" />
                            </div>
                            <div class="form-group">
                                <input asp-for="CorreoElectronico" type="email" class="form-control" placeholder="Correo Electronico *" value="" />
                            </div>
                            <div class="form-group">
                            </div>
                            <input type="submit" class="btnRegister" value="Registrar" class = "btn btn-primary" />
                        </div>
                    </div>
                </form>
                <form class="tab-pane fade show" id="profile" role="tabpanel" aria-labelledby="profile-tab" asp-action ="Admin" method="post">
                    <h3 class="register-heading">Aplicar como administrador</h3>
                    <div class="row register-form">
                        <div class="col-md-6">
                            <div class="form-group">
                                <input asp-for="Nombre" type="text" class="form-control" placeholder="Nombre *" value="" oninput="this.value = this.value.replace(/[^a-zA-Z]/g, '')" />
                            </div>
                            <div class="form-group">
                                <input asp-for="ApPaterno" type="text" class="form-control" placeholder="Apellido Paterno *" value="" oninput="this.value = this.value.replace(/[^a-zA-Z]/g, '')" />
                            </div>
                            <div class="form-group">
                                <input asp-for="ApMaterno" type="text" class="form-control" placeholder="Apellido Materno *" value="" oninput="this.value = this.value.replace(/[^a-zA-Z]/g, '')" />
                            </div>
                            <div class="form-group">
                                <input asp-for="Contrasena" type="password" class="form-control" placeholder="Contraseña *" value="" />
                            </div>
                            <div class="form-group">
                                <input asp-for="IdUsuario" type="text" class="form-control" placeholder="No. de empleado *" value="" oninput="this.value = this.value.replace(/[^0-9]/g, '')" />
                            </div>
                            <div class="form-group">
                                <input asp-for="CorreoElectronico" type="email" class="form-control" placeholder="Correo Electronico *" value="" />
                            </div>
                            <div class="form-group">
                            </div>
                            <input type="submit" class="btnRegister" value="Registrar" class="btn btn-primary" />
                        </div>
                    </div>
                </form>
            </div>
        </div>
        <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
        <script>
        $(document).ready(function() {
            $('form input').on('keydown', function(e) {
                if (e.which == 13) { // Enter key
                    e.preventDefault();
                    var nextInput = $('input[type=text],input[type=password],input[type=email]', $(this).closest('form')).eq($('input[type=text],input[type=password],input[type=email]', $(this).closest('form')).index(this) + 1);
                    if (nextInput.length) {
                        nextInput.focus();
                    } else {
                        $(this).closest('form').submit();
                    }
                }
            });
        });
        </script>
    </div>
</div>
