@model DonkeyLearn.Models.DatosModel
@{
    ViewData["Title"] = "Inicio2";
}
<!doctype html>
<!--[if lte IE 9]>
<html lang="en" class="oldie">
<![endif]-->
<!--[if gt IE 9]><!-->
<html lang="en">
<!--<![endif]-->
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="~/css/inicio2.css" rel="stylesheet" />
    <link href="~/css/fondomovimiento.css" rel="stylesheet" media="all" />
</head>
<body>
<div class="container register">
    <div class="row">
        <div class="col-md-3 register-left">
            <h3>Bienvenido</h3>
            <p>Llena los datos que se te solicitan</p>

            <a asp-action="Inicio" type="submit" name="" value="volver" class="btn btn-primary">Volver</a><br />

        </div>
        <div class="col-md-9 register-right">
            <ul class="nav nav-tabs nav-justified" id="myTab" role="tablist">
                <li class="nav-item">
                    <a class="nav-link active" id="home-tab" data-toggle="tab" href="#home" role="tab" aria-controls="home" aria-selected="true">Profesor</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" id="profile-tab" data-toggle="tab" href="#profile" role="tab" aria-controls="profile" aria-selected="false">Administrador</a>
                </li>
            </ul>
            <div class="tab-content" id="myTabContent">
                <form class="tab-pane fade show active" id="home" role="tabpanel" aria-labelledby="home-tab" asp-action="Profe" method="post">
                    <h3 class="register-heading">Registrate como profesor</h3>
                    <div class="row register-form">
                        <div class="col-md-6">
                            <div class="form-group">
                                <input required maxlength="30" asp-for="Nombre" type="text" class="form-control" placeholder="Nombre *" value="" oninput="this.value = this.value.replace(/[^a-zA-Z\sáéíóú]/g, '')" />
                            </div>
                            <div class="form-group">
                                <input required maxlength="35" asp-for="ApPaterno" type="text" class="form-control" placeholder="Apellido Paterno *" value="" oninput="this.value = this.value.replace(/[^a-zA-Z\áéíóú]/g, '')" />
                            </div>
                            <div class="form-group">
                                <input required maxlength="35" asp-for="ApMaterno" type="text" class="form-control" placeholder="Apellido Materno *" value="" oninput="this.value = this.value.replace(/[^a-zA-Z\áéíóú]/g, '')" />
                            </div>
                            <div class="form-group">
                                <input required asp-for="Contrasena" type="password" class="form-control" placeholder="Contraseña *" value="" pattern="^(?=.*[A-Z])(?=.*\d)(?=.*[^\w\s]).{8,}$" minlength ="8"/>
                             <label>Tu contraseña debe contar con al menos: <br />- Una letra mayúscula<br />-Una letra minúscula<br />-Un número <br /> -Un caracter especial (-, #, $, &, %, etc)</label>
                            </div>
                            <div class="form-group">
                                <input required asp-for="IdUsuario" type="text" class="form-control" placeholder="No. de empleado *" value="" oninput="this.value = this.value.replace(/[^0-9]/g, '')" minlength="2" maxlength="10" />
                            </div>
                            <div class="form-group">
                                <input required maxlength="320" asp-for="CorreoElectronico" type="email" class="form-control" placeholder="Correo Electronico *" value="" />
                            </div>
                            <div class="form-group">
                            </div>
                            <input type="submit" class="btnRegister btn btn-primary" value="Registrar" id="btnSubmit" />
                            <script>
                                // Obtén el campo de contraseña y el botón de envío
                                var passwordInput = document.getElementById('Contrasena');
                                var submitButton = document.getElementById('btnSubmit');

                                // Agrega un evento input al campo de contraseña
                                passwordInput.addEventListener('input', function () {
                                    // Obtén el valor de la contraseña
                                    var password = passwordInput.value;

                                    // Verifica si el valor cumple con el patrón
                                    var pattern = /^(?=.*[A-Z])(?=.*\d)(?=.*[^\w\s]).{8,}$/;
                                    var isValid = pattern.test(password);

                                    // Habilita o deshabilita el botón de envío según se cumpla el patrón
                                    submitButton.disabled = !isValid;
                                });
                            </script>
                        </div>
                    </div>
                </form>
                <form class="tab-pane fade show" id="profile" role="tabpanel" aria-labelledby="profile-tab" asp-action="Admin" method="post">
                    <h3 class="register-heading">Registrate como administrador</h3>
                    <div class="row register-form">
                        <div class="col-md-6">
                            <div class="form-group">
                                <input required maxlength="30" asp-for="Nombre" type="text" class="form-control" placeholder="Nombre *" value="" oninput="this.value = this.value.replace(/[^a-zA-Z\sáéíóú]/g, '')" />
                            </div>
                            <div class="form-group">
                                <input required maxlength="35" asp-for="ApPaterno" type="text" class="form-control" placeholder="Apellido Paterno *" value="" oninput="this.value = this.value.replace(/[^a-zA-Z\áéíóú]/g, '')" />
                            </div>
                            <div class="form-group">
                                <input required maxlength="35" asp-for="ApMaterno" type="text" class="form-control" placeholder="Apellido Materno *" value="" oninput="this.value = this.value.replace(/[^a-zA-Z\áéíóú]/g, '')" />
                            </div>
                            <div class="form-group">
                                <input required asp-for="Contrasena" type="password" class="form-control" placeholder="Contraseña *" value="" pattern="^(?=.*[A-Z])(?=.*\d)(?=.*[^\w\s]).{8,}$" minlength="8" />
                                <label>Tu contraseña debe contar con al menos: <br />- Una letra mayúscula<br />-Una letra minúscula<br />-Un número <br /> -Un caracter especial (-, #, $, &, %, etc)</label>
                            </div>
                            <div class="form-group">
                                <input required asp-for="IdUsuario" type="text" class="form-control" placeholder="No. de empleado *" value="" oninput="this.value = this.value.replace(/[^0-9]/g, '')" minlength="2" maxlength="10" />
                            </div>
                            <div class="form-group">
                                <input required maxlength="320" asp-for="CorreoElectronico" type="email" class="form-control" placeholder="Correo Electronico *" value="" />
                            </div>
                            <div class="form-group">
                            </div>
                            <input type="submit" class="btnRegister btn btn-primary" value="Registrar" id="btnSubmit" />
                            <script>
                            // Obtén el campo de contraseña y el botón de envío
                            var passwordInput = document.getElementById('Contrasena');
                            var submitButton = document.getElementById('btnSubmit');

                            // Agrega un evento input al campo de contraseña
                            passwordInput.addEventListener('input', function() {
                                // Obtén el valor de la contraseña
                                var password = passwordInput.value;

                                // Verifica si el valor cumple con el patrón
                                var pattern = /^(?=.*[A-Z])(?=.*\d)(?=.*[^\w\s]).{8,}$/;
                                var isValid = pattern.test(password);

                                // Habilita o deshabilita el botón de envío según se cumpla el patrón
                                submitButton.disabled = !isValid;
                            });
                        </script>

                        </div>
                    </div>
                </form>
            </div>
        </div>
        
    </div>
</div>
</body>
</html>