@model DonkeyLearn.Models.DatosModel
@{
    ViewData["Title"] = "RecuperarContra";
}

@if (!string.IsNullOrEmpty(TempData["Error"] as string))
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}
<link rel="stylesheet" href="~/css/RecuperarContra.css" />

<div class="form-container">
    <div class="logo-container">
        ¿Olvidaste tu contraseña?
    </div>

    <form class="form" asp-action="RecuperarContra" method="post">
        <div class="form-group">
            <label for="Correo">Correo</label>
            <input asp-for="CorreoElectronico" type="email" name="CorreoElectronico" placeholder="Introduce tu correo" required>
        </div>

        <button class="form-submit-btn" type="submit">Enviar contraseña</button>
    </form>
</div>
