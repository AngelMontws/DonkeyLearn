@model DonkeyLearn.Models.DatosModel
@{
    ViewData["Title"] = "Unirse";
}

@if (!string.IsNullOrEmpty(TempData["Error"] as string))
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}
<link href="~/css/licencia.css" rel="stylesheet" />
<header>
    <h1>Donkey Learn</h1>
</header>
<main>
    <section class="hero">
        <h2>¡Unete a un grupo!</h2>
        <p>Ingresa los 14 digitos y letras de tu código de grupo</p>
        <form asp-controller="Profe" asp-action="Validar" method="post">
            <input type="text" placeholder="Clave de profesor" asp-for="grupo" required>
            <input type="submit" class="btn btn-success">
        </form>
        <a asp-action="Inicio" asp-controller="Inicio" class="btn btn-dark">Volver</a>
        <!-- Botón para eliminar cuenta -->
        <form asp-controller="Profe" asp-action="EliminarCuenta" method="post" style="display:inline;">
            <input type="hidden" name="ID_usuario" value="@Model.IdUsuario" />
            <input type="submit" class="btn btn-danger" value="Eliminar cuenta" onclick="return confirm('¿Estás seguro de que deseas eliminar tu cuenta? Esta acción no se puede deshacer.');" />
        </form>
    </section>
    <section class="thanks">
        <h2>Gracias por elegir Donkey Learn!</h2>
        <p>Continúa tu aprendizaje con nosotros.</p>
    </section>
</main>
<footer>
    <p>&copy; 2024 Donkey Learn</p>
</footer>
