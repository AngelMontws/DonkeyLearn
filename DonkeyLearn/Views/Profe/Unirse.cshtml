@model DonkeyLearn.Models.DatosModel
@{
    ViewData["Title"] = "Unirse";
}

@if (!string.IsNullOrEmpty(TempData["Error"] as string))
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}
<link href="~/css/licencia.css" rel="stylesheet" />
<header>
    <h1 style="font-family: Impact, Haettenschweiler, 'Arial Narrow Bold', sans-serif"><font size="15">DONKEYLEARN</font></h1>
</header>
<head>
    <title>Licencia</title>
    <link rel="icon" type="image/png" href="i" />
</head>
<main>
    <section class="hero">
        <h2>¡Unete a un grupo!</h2>
        <p>Ingresa los 14 digitos y letras de tu código de grupo</p>
        <form asp-controller="Profe" asp-action="Validar" method="post">
            <input type="text" placeholder="Clave de profesor" asp-for="grupo" required>
            <input type="submit" class="btn btn-success">
        </form>
        <a asp-action="Inicio" asp-controller="Inicio" class="btn btn-dark" style="background-color:#800040" >Volver</a>
    </section>
    <section class="thanks">
        <h2 style="color: #fff;">Gracias por elegir Donkey Learn!</h2>
        <p style="color: #fff;">Continúa tu aprendizaje con nosotros.</p>
    </section>
</main>
<footer>
    <p>&copy; 2024 Donkey Learn</p>
</footer>
