@{
    ViewData["Title"] = "ReporteClase";
}

@if (!string.IsNullOrEmpty(TempData["Mensaje"] as string))
{
    <div class="alert alert-success">
        @TempData["Mensaje"]
    </div>
}
@if (!string.IsNullOrEmpty(TempData["Error"] as string))
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Menú Profesor </title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/meyer-reset/2.0/reset.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link href="~/css/reportesprofe.css" rel="stylesheet" />
</head>
<p style="margin: 25px;">
    <center>
    <h1 style="font-family: Impact, Haettenschweiler, 'Arial Narrow Bold', sans-serif"><font size="15">RENDIMIENTO GENERAL</font></h1>
    </center>
</p>
<div class="container">
    <section class="sidebar">
        <nav class="navbar">
            <ul class="navbar__menu">
                <li class="navbar__item">
                    <a href="Cuestionario" class="navbar__link"><i class="fas fa-list-check"></i><span>Cuestionarios</span></a>
                </li>
                <li class="navbar__item">
                    <a href="MenuProfe" class="navbar__link"><i class="fas fa-arrow-left"></i><span>Volver</span></a>
                </li>
            <li>
                <li class="navbar__item">
                    <a asp-action="Cuenta" asp-controller="Cuenta" class="navbar__link"><i class="fas fa-gear"></i><span>Ajustes de cuenta</span></a>
                </li>
                <li class="navbar__item">
                    <a href="@Url.Action("Logout", "Admin")" class="navbar__link"><i class="fas fa-circle-xmark"></i><span>Cerrar sesión</span></a>
                </li>
                </ul>
                </nav>
    </section>
    <section class="main-content">
        <canvas id="myChart"></canvas>
    </section>
</div>
<div class="toggle-sidebar">
    <i class="fas fa-bars"></i>
</div>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    var ctx = document.getElementById('myChart').getContext('2d');
    var myChart = new Chart(ctx, {
        type: 'bar',
        data: {
            labels: @Html.Raw(Json.Serialize(ViewBag.Nom)),
            datasets: [{
                label: '# de Promedio',
                data: @Html.Raw(Json.Serialize(ViewBag.Prom)),
                backgroundColor: 'rgba(75, 192, 192, 0.2)',
                borderColor: 'rgba(75, 192, 192, 1)',
                borderWidth: 1
            }]
        },
        options: {
            scales: {
                y: {
                    beginAtZero: true,
                    max : 100
                }
            }
        }
    });
</script>

