
@{
    ViewData["Title"] = "ReporteClase";
}

@if (!string.IsNullOrEmpty(TempData["Mensaje"] as string))
{
    <div class="alert alert-success">
        @TempData["Mensaje"]
    </div>
}
@if (!string.IsNullOrEmpty(TempData["Error"] as string))
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}
<style>
    form {
        height: 500px; /* Ajusta esto a la altura que desees */
        overflow-y: auto; /* Permite el desplazamiento vertical */
    }
</style>
<link href="~/css/admin.css" rel="stylesheet" />
<div class="container">
    <section class="sidebar">
        <ul>
            <li>
                <a asp-action="Cuestionario" class="btn btn-dark">
                    <span class="icon"><i class="fas fa-user"></i></span>
                    <span class="title">Cuestionario</span>
                </a>
            </li>
            <li>
                <a asp-action="MenuProfe" class="btn btn-dark">
                    <span class="icon"><i class="fas fa-user"></i></span>
                    <span class="title">Inicio</span>
                </a>
            </li>
            <li>
            </li>
            <li>
                <a asp-action="Cuenta" asp-controller="Cuenta" class="btn btn-dark">
                    <span class="icon"><i class="fas fa-cog"></i></span>
                    <span class="title">Ajustes de cuenta</span>
                </a>
            </li>
            <li>
                <a href="@Url.Action("Logout", "Admin")" class="btn btn-dark">
                    <span class="icon"><i class="fas fa-sign-out-alt"></i></span>
                    <span class="title">Cerrar sesión</span>
                </a>
            </li>
        </ul>
    </section>
    <section class="main-content">
        <canvas id="myChart"></canvas>
    </section>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Obtener los datos de los ViewBag
        var nombres = @Html.Raw(Json.Serialize(ViewBag.NomCues));
        var promedios = @Html.Raw(Json.Serialize(ViewBag.Prom));

        // Crear el contexto del gráfico
        var ctx = document.getElementById('myChart').getContext('2d');

        // Crear el gráfico de barras
        var myChart = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: nombres,
                datasets: [{
                    label: 'Promedios',
                    data: promedios,
                    backgroundColor: 'rgba(75, 192, 192, 0.2)',
                    borderColor: 'rgba(75, 192, 192, 1)',
                    borderWidth: 1
                }]
            },
            options: {
                scales: {
                    y: {
                        beginAtZero: true
                    }
                }
            }
        });
    </script>

</div>
<div class="toggle-sidebar">
    <i class="fas fa-bars"></i>
</div>
