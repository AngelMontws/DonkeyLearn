@model DonkeyLearn.Models.DatosModel
@{
    ViewData["Title"] = "MenuProfe";
    var materias = ViewData["Materias"] as List<MateriaModel>;
    var datos = ViewData["Datos"] as DatosModel;
}
@if (!string.IsNullOrEmpty(TempData["Mensaje"] as string))
{
    <div class="alert alert-success">
        @TempData["Mensaje"]
    </div>
}
@if (!string.IsNullOrEmpty(TempData["Error"] as string))
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Menú </title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/meyer-reset/2.0/reset.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link href="~/css/menualumno2.css" rel="stylesheet" />
</head>
<div class="container">
    <section class="sidebar">
        <nav class="navbar">
            <ul class="navbar__menu">

            <li class="navbar__item">
                <a href="Cuestionario" class="navbar__link"><i class="fas fa-list-check"></i><span>Cuestionarios</span></a>
            </li>
            <li class="navbar__item">
                <a href="ReporteClase" class="navbar__link"><i class="fas fa-folder-open"></i><span>Reportes</span></a>
            </li>
            <li class="navbar__item">
                <a asp-action="Cuenta" asp-controller="Cuenta" class="navbar__link"><i class="fas fa-gear"></i><span>Ajustes de cuenta</span></a>
            </li>
            <li>
                <a href="@Url.Action("Logout", "Admin")" class="btn btn-dark">
                    <span class="icon"><i class="fas fa-sign-out-alt"></i></span>
                    <span class="title">Cerrar sesión</span>
                </a>
            </li>
       </ul>
        </nav>
    </section>
    <section class="main-content">
        <table class="table">
            <thead>
                <tr>
                    <th>Materia</th>
                    <th>Clave para alumno</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var materia in materias)
                {
                    <tr>
                        <td>@materia.Nombre</td>
                        <td>@materia.llave</td>
                    </tr>
                }
            </tbody>
            </table>
        
        <br/>
        <form asp-action="Añadir" method="post">
            <h2>Añade más clases</h2>
            <input type="text" placeholder="Clave clase" asp-for="grupo" required>
            <button type="submit">Ingresar</button>
        </form>

    </section>
</div>
<div class="toggle-sidebar">
    <i class="fas fa-bars"></i>
</div>
