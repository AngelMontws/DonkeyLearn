@model DonkeyLearn.Models.CuestionarioModel

@{
    ViewData["Title"] = "Cuestionario";
}
@if (!string.IsNullOrEmpty(TempData["Mensaje"] as string))
{
    <div class="alert alert-success">
        @TempData["Mensaje"]
    </div>
}
@if (!string.IsNullOrEmpty(TempData["Error"] as string))
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}
<style>
    form {
        height: 500px; /* Ajusta esto a la altura que desees */
        overflow-y: auto; /* Permite el desplazamiento vertical */
    }
</style>
<link href="~/css/admin.css" rel="stylesheet" />
<div class="container">
    <section class="sidebar">
        <ul>
            <li>
                <a asp-action="Cuestionario" class="btn btn-dark">
                    <span class="icon"><i class="fas fa-user"></i></span>
                    <span class="title">Materias</span>
                </a>
            </li>
            <li>
                <button>
                    <span class="icon"><i class="fas fa-file-alt"></i></span>
                    <span class="title">Reportes</span>
                </button>
            </li>
            <li>
                <a asp-action="Cuenta" asp-controller="Cuenta" class="btn btn-dark">
                    <span class="icon"><i class="fas fa-cog"></i></span>
                    <span class="title">Ajustes de cuenta</span>
                </a>
            </li>
            <li>
                <a href="@Url.Action("Logout", "Admin")" class="btn btn-dark">
                    <span class="icon"><i class="fas fa-sign-out-alt"></i></span>
                    <span class="title">Cerrar sesión</span>
                </a>
            </li>
        </ul>
    </section>
    <section class="main-content">
        <section class="main-content">
            <!--Debe validar que haya mínimo una respuesta correcta por pregunta-->
            <form asp-action="InsertarCuestionario" method="post" onsubmit="return confirm('¿Estás seguro de que quieres añadir el cuestionario? No podrás modificarlo después');">
                <div>
                    <label for="materia">Escoge tu materia:</label>
                    @Html.DropDownList("Materia", (IEnumerable<SelectListItem>)ViewBag.Materias)
                </div>
                <h1>Cuestionario</h1>
                <div>
                    <label for="nombreCuestionario">Nombre de cuestionario:</label>
                    <input type="text" id="nombreCuestionario" name="NombreCuestionario" required />
                </div>
                <div>
                    @for (int i = 0; i < Model.Preguntas.Count; i++)
                    {
                        <div>
                            <label for="pregunta@(i+1)">Pregunta @(i + 1):</label>
                            <input type="text" id="pregunta" name="Preguntas[@i].Pregunta" required />
                        </div>
                        for (int j = 0; j < Model.Preguntas[i].Respuestas.Count; j++)
                        {
                            <div>
                                <label for="inciso@(j + 1)">Inciso @(j + 1):</label>
                                <input type="text" id="inciso@(j + 1)" name="Preguntas[@i].Respuestas[@j].Respuesta" required />
                                <input type="checkbox" id="correcta@(j + 1)" name="Preguntas[@i].Respuestas[@j].EsCorrecta" value="true" />
                                <label for="correcta@(j + 1)">Correcta</label>
                            </div>
                        }
                    }
                </div>
                <button type="button" onclick="addQuestion()">Añadir pregunta</button>
                <button type="submit" >Enviar</button>
                <script>
                    function validateForm() {
                        var questionCount = @Model.Preguntas.Count;
                        for (var i = 0; i < questionCount; i++) {
                            var checkboxes = document.getElementsByName(`Preguntas[${i}].Respuestas[0].EsCorrecta`);
                            var isChecked = Array.prototype.slice.call(checkboxes).some(x => x.checked);
                            if (!isChecked) {
                                alert(`Aún hay preguntas sin respuesta correcta`);
                                return false;
                            }
                        }
                        return true;
                    }
                </script>
            </form>
            <button type="button" onclick="deleteQuestion()" id="deleteQuestionButton" disabled>Eliminar pregunta</button>
        </section>
    </section>
    <script>
        var questionCount = @Model.Preguntas.Count;
    </script>
    <script src="~/js/cuestionario.js"></script>
</div>
<div class="toggle-sidebar">
    <i class="fas fa-bars"></i>
</div>