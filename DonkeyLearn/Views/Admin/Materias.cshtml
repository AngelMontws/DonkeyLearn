@{
    ViewData["Title"] = "MenuAdmin";
    var materias = ViewData["Materias"] as List<MateriaModel>;
    var datos = ViewData["Datos"] as DatosModel;

}
@if (!string.IsNullOrEmpty(TempData["Mensaje"] as string))
{
    <div class="alert alert-success">
        @TempData["Mensaje"]
    </div>
}
@if (!string.IsNullOrEmpty(TempData["Error"] as string))
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}
<link href="~/css/admin.css" rel="stylesheet" />
<div class="container">
    <section class="sidebar">
        <ul>
            <li>
                <a asp-action="Materias" class="btn btn-dark">
                    <span class="icon"><i class="fas fa-user"></i></span>
                    <span class="title">Materias</span>
                </a>
            </li>
            <li>
                <a asp-action="Profes" class="btn btn-dark">
                    <span class="icon"><i class="fas fa-user"></i></span>
                    <span class="title">Administrar profesores</span>
                </a>
            </li>
            <li>
                <button>
                    <span class="icon"><i class="fas fa-file-alt"></i></span>
                    <span class="title">Reportes</span>
                </button>
            </li>
            <li>
                <a asp-action="Cuenta" asp-controller="Cuenta" class="btn btn-dark">
                    <span class="icon"><i class="fas fa-cog"></i></span>
                    <span class="title">Ajustes de cuenta</span>
                </a>
            </li>
            <li>
                <a href="@Url.Action("Logout", "Admin")" class="btn btn-dark">
                    <span class="icon"><i class="fas fa-sign-out-alt"></i></span>
                    <span class="title">Cerrar sesión</span>
                </a>
            </li>
        </ul>
    </section>
    <section class="main-content">
        <table class="table">
            <thead>
                <tr>
                    <th>Código para profesor</th>
                    <th>Materia</th>
                    <th>Código para alumno</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in materias)
                {
                    <tr>
                        <td>@item.ID</td>
                        <td>@item.Nombre</td>
                        <td>@item.llave</td>
                        <td>
                            <form asp-action="EliminarMateria" asp-controller="Admin" method="post" onsubmit="return confirm('¿Estás seguro de que quieres eliminar esta materia?');">
                                <input type="hidden" name="id" value="@item.ID" />
                                <!--<input type="hidden" name="llave" value="@item.llave" />-->
                                <input type="submit" value="Eliminar" class="btn btn-danger" />
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <section class="main-content">
            <!-- Resto del código... -->
            <div class="new-class-form">
                <h2>CREA UNA NUEVA CLASE</h2>
                <form asp-action="CrearClase" asp-controller="Admin" method="post">
                    <input type="text" name="nombreClase" placeholder="Nombra tu clase" required />
                    <input type="submit" value="Añadir clase" class="btn btn-success btn-block" />
                </form>
            </div>
        </section>
    </section>
</div>
<div class="toggle-sidebar">
    <i class="fas fa-bars"></i>
</div>
