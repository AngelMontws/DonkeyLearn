@{
    ViewData["Title"] = "MenuAdmin";
    var materias = ViewData["Materias"] as List<MateriaModel>;
    var datos = ViewData["Datos"] as DatosModel;

}
@if (!string.IsNullOrEmpty(TempData["Mensaje"] as string))
{
    <div class="alert alert-success">
        @TempData["Mensaje"]
    </div>
}
@if (!string.IsNullOrEmpty(TempData["Error"] as string))
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Materias </title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/meyer-reset/2.0/reset.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link href="~/css/materias.css" rel="stylesheet" />
</head>
<p style="margin: 25px;">
    <h1 style="font-family: Impact, Haettenschweiler, 'Arial Narrow Bold', sans-serif"><font size="15">ADMINISTRA TUS MATERIAS</font></h1>
</p>
<div class="container">
    <section class="sidebar">
        <nav class="navbar">
  <ul class="navbar__menu">
    <li class="navbar__item">
      <a href="MenuAdmin" class="navbar__link"><i class="fas fa-folder-open"></i><span>Reportes</span></a>
    </li>
    <li class="navbar__item">
      <a href="Profes" class="navbar__link"><i class="fa-solid fa-users"></i><span>Administrar profesores</span></a>        
    </li>
    <li class="navbar__item">
        <a href="Alumnos" class="navbar__link"><i class="fa-solid fa-users"></i><span>Administrar alumnos</span></a>
    </li>
    <li class="navbar__item">
      <a href="Cuenta" class="navbar__link"><i class="fas fa-gear"></i><span>Ajustes de cuenta</span></a>        
    </li>
    <li class="navbar__item">
      <a href="@Url.Action("Logout", "Admin")" class="navbar__link"><i class="fas fa-circle-xmark"></i><span>Cerrar sesión</span></a>        
    </li>
  </ul>
</nav>
</html>
    </section>
    <section class="main-content">
        <table class="table">
            <thead>
                <tr>
                    <th>Código para profesor</th>
                    <th>Materia</th>
                    <th>Código para alumno</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in materias)
                {
                    <tr>
                        <td>@item.ID</td>
                        <td>@item.Nombre</td>
                        <td>@item.llave</td>
                        <td>
                            <form asp-action="EliminarMateria" asp-controller="Admin" method="post" onsubmit="return confirm('¿Estás seguro de que quieres eliminar esta materia?');">
                                <input type="hidden" name="id" value="@item.ID" />
                                <input type="hidden" name="llave" value="@item.llave" />
                                <input type="submit" value="Eliminar" class="btn btn-danger" />
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <section class="main-content">
            <!-- Resto del código... -->
            <div class="new-class-form">
                <h2>CREA UNA NUEVA CLASE</h2>
                <form asp-action="CrearClase" asp-controller="Admin" method="post">
                    <input type="text" name="nombreClase" placeholder="Nombra tu clase" required />
                    <input type="submit" value="Añadir clase" class="btn btn-success btn-block" />
                </form>
            </div>
        </section>
    </section>
</div>
<div class="toggle-sidebar">
    <i class="fas fa-bars"></i>
</div>
