
@{
    ViewData["Title"] = "MenuAdmin";
    var profes = ViewData["Profes"] as List<ProfesorModel>;
    var datos = ViewData["Datos"] as DatosModel;
    var profe = ViewData["Profesor"] as ProfesorModel;
}
@if (!string.IsNullOrEmpty(TempData["Mensaje"] as string))
{
    <div class="alert alert-success">
        @TempData["Mensaje"]
    </div>
}
@if (!string.IsNullOrEmpty(TempData["Error"] as string))
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}
<link href="~/css/admin.css" rel="stylesheet" />
<div class="container">
    <section class="sidebar">
        <ul>
            <li>
                <a asp-action="Materias" class="btn btn-dark">
                    <span class="icon"><i class="fas fa-user"></i></span>
                    <span class="title">Materias</span>
                </a>
            </li>
            <li>
                <a asp-action="MenuAdmin" class="btn btn-dark">
                    <span class="icon"><i class="fas fa-user"></i></span>
                    <span class="title">Reportes</span>
                </a>
            </li>
            <li>
                <a asp-action="Cuenta" asp-controller="Cuenta" class="btn btn-dark">
                    <span class="icon"><i class="fas fa-cog"></i></span>
                    <span class="title">Ajustes de cuenta</span>
                </a>
            </li>
            <li>
                <a href="@Url.Action("Logout", "Admin")" class="btn btn-dark">
                    <span class="icon"><i class="fas fa-sign-out-alt"></i></span>
                    <span class="title">Cerrar sesión</span>
                </a>
            </li>
        </ul>
    </section>
    <section class="main-content">
        <nav class="navbar navbar-light bg-light">
            <form class="form-inline" asp-action="BuscarProfesor" method="post">
                <input class="form-control mr-sm-2" type="search" name="idUsuario" required placeholder="Número de empleado" aria-label="Search">
                <button class="btn btn-outline-success my-2 my-sm-0" type="submit">Buscar</button>
            </form>
        </nav>
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">Materia</th>
                    <th scope="col">Profesor</th>
                    <th scope="col">Nombre de usuario</th>
                    <th scope="col">Apellido Paterno</th>
                    <th scope="col">Apellido Materno</th>
                    <th scope="col">Correo</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var profesor in Model)
                {
                    <tr>
                        <td>@profesor.Materia</td>
                        <td>@profesor.Profesor</td>
                        <td>@profesor.Nom_usuario</td>
                        <td>@profesor.AP_PAT</td>
                        <td>@profesor.AP_MAT</td>
                        <td>@profesor.Correo</td>
                    </tr>
                }
            </tbody>
        </table>
    </section>
</div>
<div class="toggle-sidebar">
    <i class="fas fa-bars"></i>
</div>

