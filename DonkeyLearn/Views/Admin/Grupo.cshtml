@model DonkeyLearn.Models.DatosModel
@{
    ViewData["Title"] = "Grupo";
}
@if (!string.IsNullOrEmpty(TempData["Error"] as string))
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}
@if (!string.IsNullOrEmpty(TempData["Mensaje"] as string))
{
    <div class="alert alert-success">
        @TempData["Mensaje"]
    </div>
}
<link href="~/css/licencia.css" rel="stylesheet" />
<header>
    <h1>Donkey Learn</h1>
</header>
<main>
    <section class="hero">
        <h2>¡Empieza a personalizar tu grupo!</h2>
        <p>Ingresa los 12 dígitos y letras de la clave de tu licencia</p>
        <form asp-action="Validar" method="post">
            <input type="text" placeholder="Clave de licencia" asp-for="grupo" required>
            <button type="submit">Ingresar</button>
        </form>
        <br />
        <a asp-action="Inicio" asp-controller="Inicio" class="btn btn-dark">Volver</a>
        <br />
        <form asp-action="Grupo" method="post" onsubmit="return confirm('¿Estás seguro de que deseas eliminar tu cuenta? Esta acción no se puede deshacer.');">
            <input type="hidden" name="EliminarCuenta" value="true" />
            <button type="submit" class="btn btn-danger">Eliminar Cuenta</button>
        </form>
    </section>
    <section class="thanks">
        <h2>Gracias por elegir Donkey Learn!</h2>
        <p>Continúa tu aprendizaje con nosotros.</p>
    </section>
</main>
<footer>
    <p>&copy; 2024 Donkey Learn</p>
</footer>
